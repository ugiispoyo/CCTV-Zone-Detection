{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cctv.local/contracts/media-manifest.v1.schema.json",
  "title": "MediaManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventId": { "type": "string", "format": "uuid" },
    "files": {
      "type": "object",
      "required": ["body", "frame", "clip"],
      "properties": {
        "face": { "$ref": "#/$defs/media" },
        "body": { "$ref": "#/$defs/media" },
        "frame": { "$ref": "#/$defs/media" },
        "clip": { "$ref": "#/$defs/media" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "media": {
      "type": "object",
      "required": ["path", "mimeType", "size", "checksum"],
      "properties": {
        "path": { "type": "string" },
        "mimeType": { "enum": ["image/jpeg", "image/png", "video/mp4"] },
        "size": { "type": "integer", "minimum": 1 },
        "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
